APP_ENV=development
APP_SECRET=replace-with-a-long-random-value
DATABASE_PATH=./data/audit-data-transformer.sqlite3
STORAGE_PATH=./data/storage
WEB_ORIGIN=http://localhost:5174
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=25
DOCUMENT_MEMORY_PATH=./document-memory
DOCUMENT_MEMORY_ENABLED=true

DEMO_USER_EMAIL=user@transformer.local
DEMO_USER_PASSWORD=ChangeMe123!
DEMO_ADMIN_EMAIL=admin@transformer.local
DEMO_ADMIN_PASSWORD=ChangeAdmin123!

# Профили моделей находятся в config/llm.toml.
LLM_CONFIG_PATH=./config/llm.toml
# Необязательное переопределение active_profile из TOML:
# LLM_PROFILE=remote_qwen35
# Ключи удалённых серверов задаются только через env, например:
# REMOTE_LLM_API_KEY=replace-me

# Старые переменные используются как резервная конфигурация,
# только если файл LLM_CONFIG_PATH отсутствует.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=max-gpu-qwen:latest
LLM_TIMEOUT_SECONDS=180
